generator zod {
  provider = "prisma-zod-generator"
  output   = "./validation"
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "cockroachdb"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Pessoa {
  id             Int         @id @default(sequence())
  nome           String
  email          String
  endereco       String
  telefone       String
  data_nasc      DateTime // Use DateTime para representar data e hora
  cpf            String
  cnis           String
  cidade_ibge_id Int
  Beneficio      Beneficio[]
}

model Situacao {
  id        Int         @id @default(sequence())
  nome      String
  Beneficio Beneficio[]
}

model Tipo {
  id        Int         @id
  nome      String
  Beneficio Beneficio[]
}

model Especialista {
  id        Int         @id
  nome      String
  email     String
  telefone  String
  endereco  String
  Beneficio Beneficio[]
}

model Beneficio {
  id               Int            @id @default(sequence())
  numero_beneficio String
  situacao_id      Int
  pessoa_id        Int
  tipo_id          Int
  especialista_id  Int
  situacao         Situacao       @relation(fields: [situacao_id], references: [id])
  pessoa           Pessoa         @relation(fields: [pessoa_id], references: [id])
  tipo             Tipo           @relation(fields: [tipo_id], references: [id])
  especialista     Especialista   @relation(fields: [especialista_id], references: [id])
  Documentos       Documentos[]
  Movimentacao     Movimentacao[]
}

model Documentos {
  id           Int       @id @default(sequence())
  descricao    String
  imagem       String // Use String para representar imagens, ou relacione com uma tabela separada se for grande
  beneficio_id Int
  beneficio    Beneficio @relation(fields: [beneficio_id], references: [id])
}

model TipoMovimentacao {
  id           Int            @id
  nome         String
  Movimentacao Movimentacao[]
}

model Movimentacao {
  id                   Int              @id
  beneficio_id         Int
  tipo_movimentacao_id Int
  beneficio            Beneficio        @relation(fields: [beneficio_id], references: [id])
  tipo_movimentacao    TipoMovimentacao @relation(fields: [tipo_movimentacao_id], references: [id])
}
