generator zod {
  provider = "prisma-zod-generator"
  output   = "./validation"
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

model Pessoa {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome           String
  email          String
  endereco       String
  telefone       String
  data_nasc      DateTime // Use DateTime para representar data e hora
  cpf            String
  cnis           String
  cidade         String
  uf             String
  Beneficio      Beneficio[]
}

model Situacao {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String
  Beneficio Beneficio[]
}

model Tipo {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String
  Beneficio Beneficio[]
}

model Especialista {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome      String 
  email     String
  telefone  String
  endereco  String
  cidade    String
  uf        String
  Beneficio Beneficio[]
}

model Beneficio {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero_beneficio String
  situacao_id      String @db.Uuid
  pessoa_id        String @db.Uuid
  tipo_id          String @db.Uuid
  especialista_id  String @db.Uuid
  situacao         Situacao       @relation(fields: [situacao_id], references: [id])
  pessoa           Pessoa         @relation(fields: [pessoa_id], references: [id])
  tipo             Tipo           @relation(fields: [tipo_id], references: [id])
  especialista     Especialista   @relation(fields: [especialista_id], references: [id])
  Documentos       Documentos[]
  Movimentacao     Movimentacao[]
}

model Documentos {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  descricao    String @db.Uuid
  imagem       String @db.Uuid
  beneficio_id String @db.Uuid
  beneficio    Beneficio @relation(fields: [beneficio_id], references: [id])
}

model TipoMovimentacao {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome         String @db.Uuid
  Movimentacao Movimentacao[]
}

model Movimentacao {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  beneficio_id         String @db.Uuid
  tipo_movimentacao_id String @db.Uuid
  beneficio            Beneficio        @relation(fields: [beneficio_id], references: [id])
  tipo_movimentacao    TipoMovimentacao @relation(fields: [tipo_movimentacao_id], references: [id])
}